#!/usr/bin/env python3
"""A fake `gh` for the GitHub-half tests: `gh api` only, against a JSON state file.

State file: $FAKE_GH_STATE. Every call is appended to $FAKE_GH_STATE.calls (argv as JSON), so tests
check the command shape the driver really ran. `lag` (an integer) hides a newly created PR from
that many list reads, as GitHub's read view lags a write. `lag_on_merge` does the same for a merge:
for that many PR-list reads after it, every read of the PR shows it as it was before the merge.
"""
import json, os, re, sys

path = os.environ["FAKE_GH_STATE"]
st = json.load(open(path))
argv = sys.argv[1:]
with open(path + ".calls", "a") as fh:
    fh.write(json.dumps(argv) + "\n")

def save():
    json.dump(st, open(path, "w"))

def fail(code, msg):
    sys.stderr.write(f"gh: {msg} (HTTP {code})\n"); sys.exit(1)

if argv[:1] != ["api"]:
    fail(400, "fake gh supports only `gh api`")
method, fields, i, endpoint = "GET", {}, 1, None
while i < len(argv):
    a = argv[i]
    if a in ("-X", "--method"):
        method = argv[i + 1]; i += 2; continue
    if a in ("-f", "-F"):
        k, _, v = argv[i + 1].partition("=")
        if v.startswith("@"):
            v = open(v[1:]).read()
        fields[k] = v; i += 2; continue
    endpoint = endpoint or a.lstrip("/"); i += 1
if st.get("unauthenticated") and method != "GET":
    fail(401, "Bad credentials")
p = endpoint.split("?")[0]

def view(pr):
    """A PR as the lagging read view shows it: unmerged and open while `merge_lag` lasts."""
    if st.get("merge_lag") and pr.get("number") == st.get("merged_number"):
        return {**pr, "state": "open", "merged": False, "merged_at": None, "merge_commit_sha": None}
    return pr

m = re.fullmatch(r"repos/([^/]+/[^/]+)/(.*)", p)
rest = m.group(2) if m else p
out = None
if method == "GET":
    if rest.startswith("branches/"):
        name = rest[len("branches/"):]
        if name not in st["branches"]:
            fail(404, "Not Found")
        out = {"name": name, "commit": {"sha": st["branches"][name]}}
    elif rest == "branches":
        out = [{"name": n, "commit": {"sha": s}} for n, s in st["branches"].items()]
    elif rest == "pulls":
        q = dict(kv.split("=", 1) for kv in endpoint.split("?", 1)[1].split("&"))
        head = q.get("head", ":").split(":", 1)[1]
        base = q.get("base")
        out = [pr for pr in st["pulls"] if (not head or pr["head"]["ref"] == head)
               and (not base or pr["base"]["ref"] == base) and (q.get("state") == "all" or pr["state"] == q.get("state"))]
        out = [view(pr) for pr in out]
        if st.get("merge_lag"):
            st["merge_lag"] -= 1; save()
        if st.get("lag"):
            hidden = st["pulls"][-1]["number"] if st["pulls"] else None
            out = [pr for pr in out if pr["number"] != hidden]
            st["lag"] -= 1; save()
    elif re.fullmatch(r"pulls/\d+", rest):
        out = next((pr for pr in st["pulls"] if pr["number"] == int(rest.split("/")[1])), None)
        if out is None:
            fail(404, "Not Found")
        out = view(out)
    elif re.fullmatch(r"commits/[^/]+/check-runs", rest):
        out = {"check_runs": st["checks"].get(rest.split("/")[1], [])}
    elif rest == "actions/runs":
        out = {"workflow_runs": []}
    elif rest in ("tags", "releases", "labels", "rulesets"):
        out = st.get(rest, [])
    elif rest.startswith("rules/branches/"):
        out = st.get("rules", [])
    else:
        fail(404, f"Not Found: {rest}")
elif method == "POST" and rest == "pulls":
    n = max([pr["number"] for pr in st["pulls"]] + [0]) + 1
    pr = {"number": n, "state": "open", "draft": False, "merged": False, "merged_at": None,
          "mergeable": True, "mergeable_state": "clean", "title": fields["title"], "body": fields.get("body", ""),
          "head": {"ref": fields["head"], "sha": st["branches"].get(fields["head"])}, "base": {"ref": fields["base"]}}
    st["pulls"].append(pr); st["lag"] = st.get("lag_on_create", 0); save(); out = pr
elif method == "PUT" and re.fullmatch(r"pulls/\d+/merge", rest):
    n = int(rest.split("/")[1])
    pr = next((x for x in st["pulls"] if x["number"] == n), None)
    if pr is None:
        fail(404, "Not Found")
    if pr["state"] != "open" or pr.get("merged"):
        fail(405, "Pull Request is not mergeable")
    if fields.get("sha") and fields["sha"] != pr["head"]["sha"]:
        fail(409, "Head branch was modified. Review and try the merge again.")
    pr.update(state="closed", merged=True, merged_at="2026-11-10T00:00:00Z", merge_commit_sha="m1")
    st["branches"][pr["base"]["ref"]] = "m1"
    st["merge_lag"], st["merged_number"] = st.get("lag_on_merge", 0), n
    save(); out = {"sha": "m1", "merged": True, "message": "Pull Request successfully merged"}
elif method == "DELETE" and rest.startswith("git/refs/heads/"):
    st["branches"].pop(rest[len("git/refs/heads/"):], None); save(); out = None
else:
    fail(404, f"Not Found: {method} {rest}")
if out is not None:
    print(json.dumps(out))
